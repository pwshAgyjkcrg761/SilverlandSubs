Dialogue: 0,0:24:12.60,0:24:15.96,Karaoke,,0,0,0,,{\k8}{\k46}Kya{\k68}hoo! {\k35}Kya{\k42}hoo! {\k46}Kya{\k91}hoo!
Dialogue: 0,0:24:12.60,0:24:15.96,OPED_Translation,,0,0,0,,Yahoo! Yahoo! Yahoo!
Dialogue: 0,0:24:15.96,0:24:19.73,Karaoke,,0,0,0,,{\k29}{\k22}Ta{\k18}ra{\k16}ri {\k18}Ra{\k20}tta {\k23}Ri{\k19}tta {\k26}Ra{\k17}tta {\k19}Ra{\k66}tta{\k69}ttaa
