Dialogue: 0,0:00:01.18,0:00:09.22,Default,,0,0,0,,The Princess Sapphire\NKnight of the Ribbon
Comment: 0,0:00:44.00,0:00:50.16,Karaoke,,0,0,0,karaoke,{\k72}{\k14}A{\k32}ta{\k40}shi {\k48}no {\k35}mi{\k52}ru {\k45}yu{\k34}me{\k30} {\k41}hi{\k44}mi{\k43}tsu {\k27}na{\k39}no{\k20}
Comment: 0,0:00:44.00,0:00:50.16,OPED_Translation,,0,0,0,karaoke,The dreams I see are my secret
Comment: 0,0:00:51.25,0:00:57.09,Karaoke,,0,0,0,karaoke,{\k53}{\k24}Da{\k13}re{\k25} {\k40}ni {\k36}mo {\k68}iwa{\k68}nai{\k56} {\k43}hi{\k40}mi{\k55}tsu {\k31}na{\k32}no
Comment: 0,0:00:51.25,0:00:57.09,OPED_Translation,,0,0,0,karaoke,I won’t tell anyone—it’s my secret
Comment: 0,0:00:58.54,0:01:02.46,Karaoke,,0,0,0,karaoke,{\k27}{\k45}A{\k26}ka{\k22}i {\k43}man{\k19}to {\k40}hi{\k26}ra {\k23}hi{\k75}ra{\k46}
